 "protokoll": {
  "daten": "AES-Lemmata; Jahresgrenzen und Handschrift aus AED-TEI. Ausgeschlossen: undatierte Texte (auch Platzhalter 1..1) und Datierungen, die mehr als 450 Jahre offen lassen",
  "zeit": "Datum einer Handschrift = Mitte ihrer Jahresgrenzen; Unsicherheit gleichverteilt zwischen den Grenzen",
  "ergaenzungen": "ganz ergaenzte Woerter und zerstoerte Stellen zaehlen nie als Uebereinstimmung; Sensitivitaet: auch teilweise ergaenzte Woerter ausschliessen",
  "M1": {
   "name": "gemeinsamer Wortlaut zwischen Abschnitten verschiedener Handschriften",
   "einheit": "Abschnitt aus L = 1000 nutzbaren Woertern, je Textgruppe in Datierungsreihenfolge gebildet; gemischte Abschnitte, deren Handschriften mehr als 150 Jahre auseinanderliegen, entfallen, ebenso Abschnitte mit weniger als 100 lueckenlosen Fuenfergruppen",
   "mass": "Anteil gemeinsamer Lemma-Fuenfergruppen, bezogen auf den kleineren Abschnitt",
   "hintergrund": "Mittel desselben Masses ueber Abschnittspaare aus verschiedenen Textgruppen",
   "modell": "E[s] = b + A * exp(-lambda * dt), kleinste Quadrate ueber alle Paare ohne gemeinsame Handschrift",
   "aufnahme": "mindestens 12 Abschnitte, 6 Cluster und 100 Jahre Spanne"
  },
  "M2": {
   "name": "derselbe Spruch oder dasselbe Werk in zwei Handschriften (Abschreibtreue)",
   "werke": "gleicher Titel in Totenbuch, Pyramidentexten und Literatur",
   "mass": "nach Ausrichtung der Lemma-Folgen: gleiche Stellen / (gleiche + abweichende Stellen) im gemeinsamen Bereich; Bloecke, die eine Luecke oder Ergaenzung beruehren, zaehlen nicht mit",
   "bedingung": "Ankerblock von mindestens 4 gleichen Woertern, mindestens 15 gleiche und 30 vergleichbare Stellen",
   "modell": "E[a] = a0 * exp(-mu * dt), gewichtet mit der Zahl vergleichbarer Stellen"
  },
  "kennzahlen": "Normtreue je Jahrhundert = exp(-100 * Rate); Halbwertszeit = ln 2 / Rate",
  "unsicherheit": "1000 Wiederholungen: Handschriften (M1) bzw. Werke (M2) mit Zuruecklegen gezogen, dazu jede Datierung neu zwischen ihren Grenzen gezogen",
  "nullmodell": "Datierungen innerhalb der Textgruppe zwischen den Handschriften vertauscht (1000-mal)",
  "vorhersagen": {
